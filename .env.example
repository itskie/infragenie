# ============================================================
# InfraGenie — Environment Variables Template
# Copy to .env and fill values. NEVER commit .env to git.
# ============================================================

# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_TEMPERATURE=0.2

# AWS (use IAM Roles in prod — keys only for local dev)
AWS_REGION=us-east-1
AWS_PROFILE=default
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ECR
ECR_REGISTRY_URI=123456789.dkr.ecr.us-east-1.amazonaws.com

# ECS
ECS_CLUSTER_NAME=infragenie-cluster
ECS_TASK_EXECUTION_ROLE_ARN=arn:aws:iam::123456789:role/ecsTaskExecutionRole
ECS_VPC_ID=vpc-xxxxxxxx
ECS_PRIVATE_SUBNET_IDS=subnet-aaa,subnet-bbb
ECS_SECURITY_GROUP_IDS=sg-xxxxxxxx

# ChromaDB
CHROMA_PERSIST_DIR=./.chroma_db

# Trivy
TRIVY_SEVERITY=HIGH,CRITICAL
TRIVY_EXIT_CODE=1

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# App
INFRAGENIE_ENV=development

# ============================================================
# LLM Provider Selection
# ============================================================
# Choose one: openai | anthropic | google | ollama
LLM_PROVIDER=google

# --- Anthropic Claude ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Google Gemini (free tier available) ---
# Get key at: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=AIza...
GOOGLE_MODEL=gemini-2.5-flash

# --- Ollama (local, no API key needed) ---
# Install: brew install ollama && ollama pull llama3.2
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
